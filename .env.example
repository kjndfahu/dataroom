# ─────────────────────────────────────────────
# API (apps/api)  — copy to apps/api/.env
# ─────────────────────────────────────────────

# Postgres (Supabase/Neon). DATABASE_URL uses the pooled connection,
# DIRECT_URL the direct one (required by Prisma Migrate).
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# JWT signing secret for API sessions (openssl rand -base64 32)
AUTH_SECRET=""
# Access token lifetime
AUTH_TOKEN_TTL="7d"

# S3-compatible blob storage (Supabase Storage / AWS S3)
S3_ENDPOINT="https://<project>.supabase.co/storage/v1/s3"
S3_REGION="eu-central-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="dataroom"
# Presigned URL lifetime, seconds
S3_URL_TTL="900"

# Max upload size in bytes (50 MB)
MAX_FILE_SIZE="52428800"

# Comma-separated origins allowed to call the API
CORS_ORIGINS="http://localhost:3000"

PORT="4000"

# ─────────────────────────────────────────────
# Web (apps/web) — copy to apps/web/.env.local
# ─────────────────────────────────────────────

NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
